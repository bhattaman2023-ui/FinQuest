# ── FINQUEST Backend Environment Variables ──────────────────────
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# ── Server ───────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
DB_DRIVER=postgres
# Set DB_DRIVER=pglite to use the persistent embedded database for local development.

# ── PostgreSQL ───────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/finquest
# Or individual fields:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=finquest
# DB_USER=postgres
# DB_PASSWORD=your_password

# ── Auth ─────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=7d
# Cookie settings (set COOKIE_SECURE=true in production with HTTPS)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ── ML Service (FastAPI) ─────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TOKEN=change_this_internal_service_token

# ── AI Provider (OpenAI-compatible) ─────────────────────────────
# Leave blank to use the non-AI educational fallback.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# ── Gamification ─────────────────────────────────────────────────
# XP amounts per action (configure here, not in code)
XP_LESSON_COMPLETE=50
XP_QUIZ_PASS=30
XP_DAILY_STREAK=10
XP_FIRST_TRADE=25
XP_CHALLENGE_COMPLETE=100

# ── Certificate ──────────────────────────────────────────────────
CERT_PASS_MARK=70
# Percentage required to pass each quiz

# ── Rate Limits ──────────────────────────────────────────────────
# Requests per 15 minutes
RATE_LIMIT_AUTH=20
RATE_LIMIT_ORDERS=30
RATE_LIMIT_AI=10
RATE_LIMIT_GENERAL=200

# ── Virtual Wallet ───────────────────────────────────────────────
INITIAL_WALLET_BALANCE=100000
# In rupees (₹1,00,000)

# ── CORS ─────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
